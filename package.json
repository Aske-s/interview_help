{
  "name": "suisi-local",
  "version": "0.1.0",
  "private": true,
  "description": "AI 面试助手 - 桌面悬浮 AI 助手（Key 自己配，网关可换）",
  "author": "local",
  "license": "MIT",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build": "electron-vite build",
    "build:native": "bash native/system-audio/build.sh && bash native/cursor-hide/build.sh && bash native/keyboard-guard/build.sh",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "verify": "npm run typecheck && npm run test && npm run build",
    "test": "npm run test:settings && npm run test:modes && npm run test:quizbar && npm run test:hover && npm run test:clickthrough && npm run test:security && npm run test:capture && npm run test:vad && npm run test:asr-dashscope && npm run test:asr-openai && npm run test:asr-server && npm run test:asr && npm run test:streaming && npm run test:stitch && npm run test:quiz && npm run test:voiceprint && npm run test:interview && npm run test:guard && npm run test:cursor && npm run test:gateway && npm run test:live && npm run test:context && npm run test:mic && npm run test:kb && npm run test:kb-purpose && npm run test:diagnostics && npm run test:system-audio",
    "test:context": "node src/main/live/__selftest__/context.cjs",
    "test:mic": "node src/renderer/src/audio/__selftest__/mic.cjs",
    "test:kb-purpose": "node src/main/knowledge/__selftest__/purpose.cjs",
    "typecheck:node": "tsc -p tsconfig.node.json --noEmit",
    "typecheck:web": "tsc -p tsconfig.web.json --noEmit",
    "test:gateway": "node scripts/verify-gateway.cjs",
    "test:live": "node src/main/live/__selftest__/run.cjs",
    "test:kb": "node src/main/knowledge/__selftest__/run.cjs",
    "test:diagnostics": "node src/main/diagnostics/__selftest__/run.cjs",
    "test:settings": "node src/main/store/__selftest__/run.cjs",
    "test:stitch": "node src/main/stitch/__selftest__/run.cjs",
    "test:quiz": "node src/main/quiz/__selftest__/run.cjs",
    "test:interview": "node src/main/interview/__selftest__/run.cjs",
    "test:guard": "node src/main/keyboard-guard/__selftest__/run.cjs",
    "test:voiceprint": "node src/main/voiceprint/__selftest__/run.cjs",
    "test:modes": "node src/main/store/__selftest__/modes.cjs",
    "test:cursor": "node src/main/cursor/__selftest__/run.cjs",
    "test:quizbar": "node src/main/quizbar/__selftest__/run.cjs",
    "test:hover": "node src/main/hover/__selftest__/run.cjs",
    "test:capture": "node src/main/capture/__selftest__/run.cjs",
    "test:clickthrough": "node src/main/clickthrough/__selftest__/run.cjs",
    "test:security": "node src/main/security/__selftest__/run.cjs",
    "test:asr": "node src/main/asr/__selftest__/run.cjs",
    "test:asr-server": "node src/main/asr/server/__selftest__/run.cjs",
    "test:vad": "node src/main/live/vad/__selftest__/run.cjs",
    "test:asr-openai": "node src/main/asr/__selftest__/openai-compat.cjs",
    "test:asr-dashscope": "node src/main/asr/__selftest__/dashscope.cjs",
    "test:streaming": "node src/main/live/__selftest__/streaming.cjs",
    "test:system-audio": "node src/main/system-audio/__selftest__/run.cjs"
  },
  "dependencies": {
    "mammoth": "^1.13.0",
    "pdfjs-dist": "^6.4.299",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.0.0",
    "electron-vite": "^6.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.0",
    "vite": "^8.3.5",
    "zustand": "^5.0.15"
  }
}
